#define DEFAULT 0
#define NUM     8
#define WIN_NUM 9
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        // Shift+6 is a dead key on Windows US International. Complete it with Space.
        win_six: win_six {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&win_literal CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Match macOS Option+S (ß) and Option+Shift+S (Í).
        win_sharp_s: win_sharp_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(S)>, <&kp RA(LS(I))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // macOS Option+Shift+2 always emits €, including with a held Shift.
        win_euro: win_euro {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(NUMBER_5)>, <&kp RA(NUMBER_5)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Preserve the existing home-row Ctrl hold while tapping a literal dead key.
        win_literal_mt: win_literal_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&win_literal>;
        };

        // Mask either home-row Shift only while sending the macOS umlaut dead key.
        // Both branches send Option+U; the shifted branch suppresses Shift.
        umlaut_deadkey: umlaut_deadkey {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(U)>, <&kp LA(U)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // US International: a dead key followed by Space emits just the character.
        // Retain a held Shift so GRAVE becomes ~ and SQT becomes a double quote.
        win_literal: win_literal {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>, <&kp SPACE>;
        };

        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        umlaut_u: umlaut_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&umlaut_deadkey &kp U>;
            label = "UMLAUT_U";
        };

        umlaut_o: umlaut_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&umlaut_deadkey &kp O>;
            label = "UMLAUT_O";
        };

        umlaut_a: umlaut_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&umlaut_deadkey &kp A>;
            label = "UMLAUT_A";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "MAC";
            bindings = <
&kp Q        &kp W        &kp E       &kp R         &kp T                              &kp Z          &kp U       &kp I       &kp O        &kp P
&mt LSHFT A  &mt LCTRL S  &mt LALT D  &mt LGUI F    &kp G                              &kp H          &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt RSHFT EQUAL
&kp Y        &kp X        &kp C       &kp V         &kp B                              &kp N          &kp M       &kp COMMA   &kp DOT      &kp MINUS
&bt BT_NXT   &to 1        &none       &lt 2 ESCAPE  &kp TAB  &lt NUM SPACE  &lt 3 ENTER  &kp BACKSPACE                                       &bt BT_CLR
            >;
        };

        win_default {
            label = "WIN";
            bindings = <
&kp Q        &kp W        &kp E       &kp R         &kp T                              &kp Z          &kp U       &kp I       &kp O        &kp P
&mt LSHFT A  &mt LCTRL S  &mt LALT D  &mt LGUI F    &kp G                              &kp H          &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt RSHFT EQUAL
&kp Y        &kp X        &kp C       &kp V         &kp B                              &kp N          &kp M       &kp COMMA   &kp DOT      &kp MINUS
&bt BT_NXT   &to 0        &none       &lt 2 ESCAPE  &kp TAB  &lt WIN_NUM SPACE  &lt 7 ENTER  &kp BACKSPACE                                       &bt BT_CLR
            >;
        };

        MouseButtons {
            label = "MBTN";
            bindings = <
&lt 6 LSHIFT  &mkp MB3   &mkp MB1   &mkp MB2   &trans                  &trans  &trans  &trans  &trans  &trans
&lt 5 LSHIFT  &mkp MCLK  &mkp LCLK  &mkp RCLK  &trans                  &trans  &trans  &trans  &trans  &trans
&trans        &trans     &trans     &trans     &trans                  &trans  &trans  &trans  &trans  &trans
&trans        &trans     &trans     &trans     &trans  &trans  &trans  &trans                          &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LC(UP_ARROW)  &kp PAGE_UP                      &kp LG(LEFT)   &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &kp F12
&trans     &trans     &trans     &trans            &kp PAGE_DOWN                    &kp LG(RIGHT)  &kp LEFT      &kp DOWN  &kp RIGHT      &kp F11
&kp F1     &kp F2     &kp F3     &kp F4            &kp F5                           &kp F6         &kp F7        &kp F8    &kp F9         &kp F10
&trans     &trans     &trans     &kp C_VOL_DN      &kp C_VOLUME_UP  &trans  &trans  &trans                                                &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        win_func {
            label = "WFUN";
            bindings = <
&kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LG(TAB)   &kp PAGE_UP                      &kp HOME  &kp LC(LEFT)  &kp UP    &kp LC(RIGHT)  &kp F12
&trans     &trans     &trans     &trans        &kp PAGE_DOWN                    &kp END   &kp LEFT      &kp DOWN  &kp RIGHT      &kp F11
&kp F1     &kp F2     &kp F3     &kp F4        &kp F5                           &kp F6    &kp F7        &kp F8    &kp F9         &kp F10
&trans     &trans     &trans     &kp C_VOL_DN  &kp C_VOLUME_UP  &trans  &trans  &trans                                           &trans
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1     &kp NUMBER_2          &kp NUMBER_3         &kp NUMBER_4                       &kp NUMBER_5                     &kp NUMBER_6  &kp NUMBER_7                &kp NUMBER_8          &kp NUMBER_9        &kp NUMBER_0
&mt LSHFT SLASH  &mt LCTRL NUBS        &mt LALT LEFT_BRACE  &mt LEFT_COMMAND LEFT_PARENTHESIS  &umlaut_u                        &kp LA(S)     &mt RGUI RIGHT_PARENTHESIS  &mt RALT RIGHT_BRACE  &mt RCTRL QUESTION  &mt RSHFT BACKSLASH
&kp GRAVE        &kp LA(LS(NUMBER_2))  &kp LESS_THAN        &kp LEFT_BRACKET                   &umlaut_o                        &umlaut_a     &kp RIGHT_BRACKET           &kp GREATER_THAN      &kp SEMI            &kp SQT
&trans           &trans                &trans               &trans                             &trans        &trans  &kp MINUS  &kp DELETE                                                                          &trans
            >;
        };

        // Windows host input source: English (United States), US International.
        // Match NUM's text and Shift output with the same physical positions.
        win_number_layer {
            label = "WNUM";
            bindings = <
&kp NUMBER_1     &kp NUMBER_2                 &kp NUMBER_3         &kp NUMBER_4                       &kp NUMBER_5                     &win_six     &kp NUMBER_7                &kp NUMBER_8          &kp NUMBER_9        &kp NUMBER_0
&mt LSHFT SLASH  &win_literal_mt LCTRL GRAVE  &mt LALT LEFT_BRACE  &mt LEFT_COMMAND LEFT_PARENTHESIS  &kp RA(Y)                        &win_sharp_s &mt RGUI RIGHT_PARENTHESIS  &mt RALT RIGHT_BRACE  &mt RCTRL QUESTION  &mt RSHFT BACKSLASH
&win_literal GRAVE &win_euro                 &kp LESS_THAN        &kp LEFT_BRACKET                   &kp RA(P)                        &kp RA(Q)    &kp RIGHT_BRACKET           &kp GREATER_THAN      &kp SEMI            &win_literal SQT
&trans           &trans                       &trans               &trans                             &trans        &trans  &kp MINUS  &kp DELETE                                                                          &trans
            >;
        };
    };
};
